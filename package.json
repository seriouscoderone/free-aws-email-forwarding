{
  "name": "free-aws-email-forwarding",
  "version": "1.0.0",
  "description": "Serverless email forwarding with AWS SES, Lambda, and CDK. Deploy your own email forwarding for any domain.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "synth": "cdk synth",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/client-secrets-manager": "^3.1140.0",
    "@aws-sdk/client-ses": "^3.1140.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1143.0",
    "esbuild": "^0.27.3",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.13",
    "typescript": "~5.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
